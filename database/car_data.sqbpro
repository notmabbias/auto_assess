INSERT INTO Vehicles (vehicle_id, make, model, year, engine_type, transmission_type, drivetrain, oil_change_interval_km)
VALUES (3, 'Nissan', '350Z', 2007, '3.5L VQ35HR', 'Manual', 'RWD', 6000);

-- 2. Insert Maintenance Schedules
INSERT INTO Maintenance_Schedules (vehicle_id, task_description, interval_km, interval_months) 
VALUES
    (3, 'Replace engine oil and filter', 6000, 6),
    (3, 'Replace dual engine air filters', 24000, 12),
    (3, 'Replace in-cabin microfilter', 24000, 12),
    (3, 'Replace manual transmission fluid', 48000, 36),
    (3, 'Replace viscous limited-slip differential fluid', 48000, 36),
    (3, 'Replace brake fluid', 48000, 36),
    (3, 'Engine coolant flush', 96000, 60),
    (3, 'Replace spark plugs (Platinum/Iridium)', 160000, 120);

-- 3. Insert Known Issues
INSERT INTO Known_Issues (vehicle_id, issue_description, severity, is_safety_recall, typical_failure_km_start, typical_failure_km_end) 
VALUES
    (3, 'Concentric Slave Cylinder (CSC) failure causing the clutch pedal to drop to the floor and loss of gears', 'Critical', 0, 60000, 120000),
    (3, 'Internal rear timing cover oil gallery gasket blowout leading to low oil pressure and catastrophic engine failure', 'Critical', 0, 100000, 160000),
    (3, 'Camshaft position sensor failure resulting in crank-no-start conditions or stalling while driving', 'High', 0, 80000, 150000),
    (3, 'Front lower control arm compression rod bushing tearing causing steering wheel vibration and uneven tire wear', 'Medium', 0, 80000, 140000),
    (3, 'Power window motor internal brush failure causing windows to get stuck in the down position', 'Low', 0, 60000, 150000),
    (3, 'Hatch struts failing to hold up the heavy rear tailgate', 'Low', 0, 80000, 160000);</sql><current_tab id="0"/></tab_sql></sqlb_project>
